# ────────────────────────────────────────────
# 로컬 개발용 환경 변수 예시
# 이 파일을 복사해서 .env.local 로 만든 뒤 값을 채워 넣으세요.
# .env.local 은 .gitignore 에 포함되어 있어 커밋되지 않습니다.
# ────────────────────────────────────────────

# ── 카카오 JavaScript SDK 앱 키 (클라이언트 공개, 카카오 공유 기능에 사용)
NEXT_PUBLIC_KAKAO_APP_KEY=3449f8fdebe88594de6bc7a8fe00b169

# ── 카카오 REST API 키 (서버 전용, 절대 NEXT_PUBLIC_ 붙이지 말 것)
# 발급: https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
# Cloudflare Pages 배포 시: Settings → Environment variables 에서도 동일하게 추가
KAKAO_REST_API_KEY=여기에_REST_API_키_입력

# ── Google Analytics 4 측정 ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT=XXXXXXXXXX
